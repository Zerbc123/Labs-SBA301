# Root .gitignore for orchid_management_v5 repository

# Dependencies
**/node_modules/

# Build outputs
**/target/
**/dist/
**/dist-ssr/
*.tsbuildinfo
.vite/

# Logs
**/*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE & Editor files
.idea/
**/.idea/
.vscode/
**/.vscode/*
!**/.vscode/extensions.json
*.iml
*.iws
*.ipr
.classpath
.project
.settings/

# OS specific files
.DS_Store
Thumbs.db
ehthumbs.db

# Environment & local files
.env.local
.env.*.local
*.local

# Maven wrapper jar exception
!.mvn/wrapper/maven-wrapper.jar
!**/chapter15api/.mvn/wrapper/maven-wrapper.jar
